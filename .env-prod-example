# =============================================================================
# REQUIRED: Application Settings (Production)
# =============================================================================

# Maximum file upload size (50MB)
MAX_CONTENT_LENGTH=52428800

# Upload folder path
UPLOAD_FOLDER=uploads

# Output folder path
OUTPUT_FOLDER=output

# Flask debug mode - MUST be false in production!
