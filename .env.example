# =============================================================================
# SENIOR LIVING RECOMMENDATION SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# GEMINI AI CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model for text/audio processing (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model for real-time voice agent (default: gemini-2.5-flash-native-audio-preview-09-2025)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# -----------------------------------------------------------------------------
# GOOGLE SHEETS CRM INTEGRATION (Optional)
# -----------------------------------------------------------------------------
# Spreadsheet ID from your Google Sheet URL
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google Cloud service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json

# -----------------------------------------------------------------------------
# APPLICATION SECURITY
# -----------------------------------------------------------------------------
# Secret key for Flask sessions (generate a random string for production)
SECRET_KEY=your-secret-key-change-in-production

# API key for external integrations (optional)
API_KEY=your_api_key_here

# Allowed origins for CORS (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# SMTP configuration for sending email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com

# Manager email for escalations
MANAGER_EMAIL=manager@yourcompany.com

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 1. GEMINI_API_KEY is required for the system to function
# 2. GOOGLE_SPREADSHEET_ID and service account are needed for CRM integration
# 3. Voice Agent uses GEMINI_LIVE_MODEL for real-time conversations
# 4. Email settings are optional - used for notifications and escalations
